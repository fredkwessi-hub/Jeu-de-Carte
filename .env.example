# ===== Configuration serveur =====
PORT=3000
NODE_ENV=development

# ===== Configuration CORS =====
# Utiliser '*' en développement, une URL spécifique en production
CORS_ORIGIN=*

# ===== Sécurité =====
# Clé secrète pour signer les sessions (à changer en production)
SESSION_SECRET=change_me_in_production

# ===== Base de données (future) =====
# DB_TYPE=json
# DB_PATH=./data

# ===== Logs =====
LOG_LEVEL=info

# ===== Jeu =====
MAX_PLAYERS_PER_GAME=4
DEFAULT_TURN_TIMEOUT=30